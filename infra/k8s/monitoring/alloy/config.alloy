discovery.kubernetes "iris_pods" {
  role = "pod"

  namespaces {
    names = ["iris"]
  }

  selectors {
    role  = "pod"
    label = "app in (iris,iris-test,iris-rejudge)"
  }
}

discovery.relabel "iris_pprof" {
  targets = discovery.kubernetes.iris_pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_ready"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    regex         = "iris"
    action        = "keep"
  }

  // iris-test and iris-rejudge also listen on 6060 but do not declare it as a container port.
  rule {
    source_labels = ["__meta_kubernetes_pod_ip"]
    regex         = "(.+)"
    replacement   = "${1}:6060"
    target_label  = "__address__"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }
}

pyroscope.scrape "iris" {
  targets                  = discovery.relabel.iris_pprof.output
  forward_to               = [pyroscope.write.local.receiver]
  scrape_interval          = "60s"
  scrape_timeout           = "20s"
  delta_profiling_duration = "10s"

  profiling_config {
    profile.block {
      enabled = false
    }
    profile.mutex {
      enabled = false
    }
  }
}

pyroscope.write "local" {
  endpoint {
    url = "http://pyroscope.monitoring-pyroscope.svc.cluster.local:4040"
  }

  external_labels = {
    environment = sys.env("ALLOY_ENVIRONMENT"),
  }
}

prometheus.exporter.blackbox "cluster_endpoints" {
  // Cluster traffic is plaintext HTTP, so a probe never sees a certificate.
  // preferred_ip_protocol pins IPv4 because ClusterIP DNS only answers with
  // A records while the blackbox default prefers IPv6.
  config = `
modules:
  http_2xx:
    prober: http
    timeout: 5s
    http:
      preferred_ip_protocol: ip4
`

  targets = [
    // client-api has no health route. /api/internal/prisma answers 200 from
    // process state without touching the database, and Prometheus already
    // scrapes it through the client-api ServiceMonitor.
    {
      name    = "client-api",
      address = "http://client-api-server.client-api.svc.cluster.local:4000/api/internal/prisma",
      module  = "http_2xx",
    },
    {
      name    = "admin-api",
      address = "http://admin-api-server.admin-api.svc.cluster.local:3000/health/ready",
      module  = "http_2xx",
    },
    {
      name    = "frontend",
      address = "http://frontend.frontend.svc.cluster.local:5525/",
      module  = "http_2xx",
    },
    {
      name    = "loki",
      address = "http://loki.monitoring-loki.svc.cluster.local:3100/ready",
      module  = "http_2xx",
    },
    {
      name    = "tempo",
      address = "http://tempo.monitoring-tempo.svc.cluster.local:3200/ready",
      module  = "http_2xx",
    },
    {
      name    = "pyroscope",
      address = "http://pyroscope.monitoring-pyroscope.svc.cluster.local:4040/ready",
      module  = "http_2xx",
    },
    {
      name    = "prometheus",
      address = "http://prometheus-kube-prometheus-prometheus.monitoring-prometheus.svc.cluster.local:9090/-/healthy",
      module  = "http_2xx",
    },
    {
      name    = "alertmanager",
      address = "http://prometheus-kube-prometheus-alertmanager.monitoring-prometheus.svc.cluster.local:9093/-/healthy",
      module  = "http_2xx",
    },
    {
      name    = "grafana",
      address = "http://grafana.monitoring-grafana.svc.cluster.local:80/api/health",
      module  = "http_2xx",
    },
  ]
}

// The exporter labels every probe `instance = <component id>` and hides the
// target name in `job`, so all nine series look alike. Move the name to
// `instance` and give every probe the same `job`.
discovery.relabel "blackbox" {
  targets = prometheus.exporter.blackbox.cluster_endpoints.targets

  rule {
    source_labels = ["job"]
    regex         = "integrations/blackbox/(.+)"
    target_label  = "instance"
  }

  rule {
    target_label = "job"
    replacement  = "blackbox"
  }
}

prometheus.scrape "blackbox" {
  targets    = discovery.relabel.blackbox.output
  forward_to = [prometheus.remote_write.local.receiver]

  // Longer than the 5s module timeout so a hung endpoint reports
  // probe_success 0 instead of failing the scrape itself.
  scrape_interval = "30s"
  scrape_timeout  = "10s"
}

prometheus.remote_write "local" {
  endpoint {
    url = "http://prometheus-kube-prometheus-prometheus.monitoring-prometheus.svc.cluster.local:9090/api/v1/write"
  }

  external_labels = {
    environment = sys.env("ALLOY_ENVIRONMENT"),
  }
}
