          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT datname, pg_size_pretty(pg_database_size(datname)) AS size,\n       numbackends, xact_commit, xact_rollback\nFROM pg_stat_database\nWHERE datname IS NOT NULL\nORDER BY pg_database_size(datname) DESC"
