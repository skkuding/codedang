    {
      "id": 8,
      "type": "table",
      "title": "차단된 세션",
      "description": "다른 세션의 락 때문에 기다리는 세션. blocked_by 의 pid 를 활성 세션 표에서 찾는다. 비어 있는 것이 정상이다.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT pid, usename, array_to_string(pg_blocking_pids(pid), ', ') AS blocked_by,\n       concat_ws(':', wait_event_type, wait_event) AS wait,\n       EXTRACT(EPOCH FROM now() - query_start) AS duration,\n       left(query, 1000) AS query\nFROM pg_stat_activity\nWHERE cardinality(pg_blocking_pids(pid)) > 0\nORDER BY query_start ASC NULLS LAST\nLIMIT 20"
        }
      ],
      "fieldConfig": {
