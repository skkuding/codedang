    {
      "id": 9,
      "type": "table",
      "title": "테이블 크기",
      "description": "용량 상위 20개 테이블. index 는 인덱스만, total 은 TOAST 를 포함한다. rows 는 추정치다. DDL 이 테이블을 잠그고 있으면 lock timeout(3초)으로 실패한다.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT relname,\n       n_live_tup AS rows,\n       pg_total_relation_size(relid) AS total,\n       pg_relation_size(relid) AS heap,\n       pg_indexes_size(relid) AS index\nFROM pg_stat_user_tables\nORDER BY pg_total_relation_size(relid) DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "total"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "heap"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "index"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "12.3.1"
    },
    {
      "id": 10,
      "type": "table",
      "title": "테이블 활동",
      "description": "통계 리셋 이후 누적값. seq_scan 이 크고 idx_scan 이 작으면 인덱스 후보, n_dead_tup 이 크고 last_vacuum 이 오래되었으면 VACUUM 이 밀린 것이다.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT relname, seq_scan, COALESCE(idx_scan, 0) AS idx_scan, n_dead_tup,\n       GREATEST(last_vacuum, last_autovacuum) AS last_vacuum\nFROM pg_stat_user_tables\nORDER BY n_dead_tup DESC, seq_scan DESC\nLIMIT 20"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "last_vacuum"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsIso"
              },
              {
                "id": "custom.width",
                "value": 170
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "12.3.1"
    },
    {
      "id": 11,
      "type": "table",
      "title": "데이터베이스",
      "description": "인스턴스의 데이터베이스 목록(템플릿 제외). stats_reset 은 누적 통계의 기준 시각이다.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
