    {
      "id": 4,
      "type": "stat",
      "title": "캐시 히트율",
      "description": "shared buffer 에서 읽은 블록 비율. 통계 리셋 이후 누적값이다.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT COALESCE(round(100.0 * sum(blks_hit) / NULLIF(sum(blks_hit + blks_read), 0), 2), 0) AS value\nFROM pg_stat_database\nWHERE datname = current_database()"
        }
      ],
      "fieldConfig": {
