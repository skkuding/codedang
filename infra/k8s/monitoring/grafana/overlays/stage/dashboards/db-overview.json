    {
      "id": 3,
      "type": "stat",
      "title": "연결 사용률",
      "description": "client backend 수 / max_connections. 90% 를 넘으면 새 연결이 거부되기 직전이다.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT round(100.0 * count(*) / current_setting('max_connections')::numeric, 1) AS value\nFROM pg_stat_activity\nWHERE backend_type = 'client backend'"
        }
      ],
