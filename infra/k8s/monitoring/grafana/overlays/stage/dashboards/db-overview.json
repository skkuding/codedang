            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT COALESCE(round(100.0 * sum(blks_hit) / NULLIF(sum(blks_hit + blks_read), 0), 2), 0) AS value FROM pg_stat_database WHERE datname = current_database()"
