  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "테이블 목록",
      "description": "public 스키마의 테이블과 뷰. 이름을 누르면 오른쪽에 그 테이블이 열린다. rows 는 대략적인 행 수이고, 뷰는 비어 있다.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 24,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT c.relname AS \"table\",\n       CASE WHEN c.relkind IN ('r', 'p')\n            THEN GREATEST(c.reltuples, 0)::bigint\n       END AS rows\nFROM pg_class c JOIN pg_namespace n ON n.oid = c.relnamespace\nWHERE n.nspname = 'public' AND c.relkind IN ('r', 'p', 'v', 'm')\n  AND has_table_privilege(c.oid, 'SELECT')\n  AND c.relname !~ '[\"'']'\nORDER BY c.relname"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "rows"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 90
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "table"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "이 테이블 열기",
                    "url": "/d/db-browser/db-browser?var-table=${__value.raw}&var-filter="
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "12.3.1"
    },
    {
      "id": 2,
      "type": "table",
      "title": "$table — 데이터",
      "description": "선택한 테이블의 행. 위쪽 변수에서 정렬 기준, 방향, 행 수, 조건을 바꾼다. 셀을 누르면 긴 값을 전부 볼 수 있다. 쿼리는 30초 안에 끝나야 한다.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 16,
        "w": 18,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT *\nFROM public.\"$table\"\nWHERE true ${filter:raw}\nORDER BY \"$order\" $dir NULLS LAST\nLIMIT $limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": true,
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "12.3.1"
    },
    {
      "id": 3,
      "type": "table",
      "title": "$table — 컬럼",
      "description": "선택한 테이블의 컬럼 이름, 타입, 빈 값 허용 여부, 기본값.",
      "datasource": {
        "type": "postgres",
        "uid": "postgres"
      },
      "gridPos": {
        "h": 8,
        "w": 18,
        "x": 6,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true,
          "format": "table",
          "rawSql": "SELECT column_name AS \"column\", data_type AS type,\n       is_nullable AS nullable, column_default AS \"default\"\nFROM information_schema.columns\nWHERE table_schema = 'public' AND table_name = '$table'\nORDER BY ordinal_position"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false,
            "filterable": true
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "pluginVersion": "12.3.1"
    }
  ],
