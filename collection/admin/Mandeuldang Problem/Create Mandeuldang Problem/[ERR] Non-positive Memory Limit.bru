meta {
  name: [ERR] Non-positive Memory Limit
  type: graphql
  seq: 1
}

post {
  url: {{gqlUrl}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreateMandeuldangProblem(
    $input: CreateMandeuldangProblemInput!
  ) {
    createMandeuldangProblem(input: $input) {
      id
      createdById
      title
      problemType
      description
      inputDescription
      outputDescription
      timeLimit
      memoryLimit
      difficulty
      languages
      creationMode
      status
      myRole
      testFileCount
      mandeuldangCollaborators {
        userId
        role
        status
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "title": "메모리 제한 테스트",
      "problemType": "General",
      "memoryLimit": -1
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
