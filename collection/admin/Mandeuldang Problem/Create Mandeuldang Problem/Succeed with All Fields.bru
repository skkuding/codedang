meta {
  name: Succeed with All Fields
  type: graphql
  seq: 1
}

post {
  url: {{gqlUrl}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation CreateMandeuldangProblem(
    $input: CreateMandeuldangProblemInput!
  ) {
    createMandeuldangProblem(input: $input) {
      id
      createdById
      title
      problemType
      description
      inputDescription
      outputDescription
      timeLimit
      memoryLimit
      difficulty
      languages
      creationMode
      status
      myRole
      testFileCount
      mandeuldangCollaborators {
        userId
        role
        status
      }
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "title": "  title  ",
      "problemType": "General",
      "description": "description.",
      "inputDescription": "input description.",
      "outputDescription": "output description.",
      "timeLimit": 1000,
      "memoryLimit": 512,
      "difficulty": "Level2",
      "languages": [
        "Golang"
      ]
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
