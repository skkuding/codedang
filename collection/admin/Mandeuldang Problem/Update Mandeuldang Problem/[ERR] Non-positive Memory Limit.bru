meta {
  name: [ERR] Non-positive Memory Limit
  type: graphql
  seq: 6
}

post {
  url: {{gqlUrl}}
  body: graphql
  auth: inherit
}

body:graphql {
  mutation UpdateMandeuldangProblem(
    $input: UpdateMandeuldangProblemInput!
  ) {
    updateMandeuldangProblem(input: $input) {
      id
      memoryLimit
    }
  }
}

body:graphql:vars {
  {
    "input": {
      "id": 11,
      "memoryLimit": -1
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  # 📙 [ERR] Non-positive Memory Limit

  **POST** `/graphql (mutation: updateMandeuldangProblem)`

  `memoryLimit`을 0 이하로 보내면,

  `UnprocessableDataException`("Memory limit must be greater than zero")가 발생합니다.
}
