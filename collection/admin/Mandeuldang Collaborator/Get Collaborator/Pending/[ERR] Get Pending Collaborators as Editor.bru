meta {
  name: [ERR] Get Pending Collaborators as Editor
  type: graphql
  seq: 4
}

post {
  url: {{gqlUrl}}
  body: graphql
  auth: bearer
}

headers {
  X-Collaborator-Test: true
  X-Collaborator-Actor: editor
}

auth:bearer {
  token: {{editorToken}}
}

body:graphql {
  query ($problemId: Int!) {
    getPendingCollaborator(problemId: $problemId) {
      id
      username
      email
      role
      status
      invitedBy {
        id
        username
      }
      invitedAt
      approvedAt
      createTime
    }
  }
}

body:graphql:vars {
  {
    "problemId": {{collabProblemId}}
  }
}

tests {
  test("Get Pending Collaborators as Editor - FORBIDDEN", function () {
    expect(res.status).to.equal(200);
    expect(res.body.errors).to.be.an("array").that.is.not.empty;
    const error = res.body.errors.find(e => e.path && e.path[0] === "getPendingCollaborator");
    expect(error).to.not.equal(undefined);
    expect(error.extensions.code).to.equal("FORBIDDEN");
    expect(error.message).to.equal("No permission to view collaborators");
    expect(res.body.data == null || res.body.data.getPendingCollaborator == null).to.equal(true);
  });
}
