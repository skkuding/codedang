meta {
  name: Change Editor to Reviewer
  type: graphql
  seq: 1
}

post {
  url: {{gqlUrl}}
  body: graphql
  auth: bearer
}

headers {
  X-Collaborator-Test: true
  X-Collaborator-Actor: owner
}

auth:bearer {
  token: {{ownerToken}}
}

body:graphql {
  mutation ($problemId: Int!, $userId: Int!) {
    updateCollaboratorRole(
      problemId: $problemId
      input: {userId: $userId, role: Reviewer}
    ) {
      id
      problemId
      userId
      role
      status
      invitedById
      invitedAt
      approvedAt
      createTime
    }
  }
}

body:graphql:vars {
  {
    "problemId": {{collabProblemId}},
    "userId": {{editorUserId}}
  }
}

tests {
  test("Change Editor to Reviewer", function () {
    expect(res.status).to.equal(200);
    expect(res.body.errors).to.be.undefined;
    const value = res.body.data.updateCollaboratorRole;
    expect(value.userId).to.equal(Number(bru.getVar("editorUserId")));
    expect(value.problemId).to.equal(Number(bru.getVar("collabProblemId")));
    expect(value.status).to.equal("Approved");
    expect(value.role).to.equal("Reviewer");
  });
}
