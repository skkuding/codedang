meta {
  name: Approve Pending Invitation
  type: graphql
  seq: 1
}

post {
  url: {{gqlUrl}}
  body: graphql
  auth: bearer
}

headers {
  X-Collaborator-Test: true
  X-Collaborator-Actor: owner
}

auth:bearer {
  token: {{ownerToken}}
}

body:graphql {
  mutation ($problemId: Int!, $userId: Int!) {
    approveInvite(problemId: $problemId, userId: $userId) {
      id
      problemId
      userId
      role
      status
      invitedById
      invitedAt
      approvedAt
      createTime
    }
  }
}

body:graphql:vars {
  {
    "problemId": {{collabProblemId}},
    "userId": {{pendingUserId}}
  }
}

tests {
  test("Approve Pending Invitation", function () {
    expect(res.status).to.equal(200);
    expect(res.body.errors).to.be.undefined;
    const value = res.body.data.approveInvite;
    expect(value.userId).to.equal(Number(bru.getVar("pendingUserId")));
    expect(value.problemId).to.equal(Number(bru.getVar("collabProblemId")));
    expect(value.status).to.equal("Approved");
    expect(value.approvedAt).to.be.a("string");
  });
}
