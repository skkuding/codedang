meta {
  name: Invite Collaborator as Owner
  type: graphql
  seq: 1
}

post {
  url: {{gqlUrl}}
  body: graphql
  auth: bearer
}

headers {
  X-Collaborator-Test: true
  X-Collaborator-Actor: owner
}

auth:bearer {
  token: {{ownerToken}}
}

body:graphql {
  mutation ($problemId: Int!, $userEmail: String!) {
    inviteCollaborator(
      problemId: $problemId
      input: {userEmail: $userEmail, role: Editor}
    ) {
      id
      problemId
      userId
      role
      status
      invitedById
      invitedAt
      approvedAt
      createTime
    }
  }
}

body:graphql:vars {
  {
    "problemId": {{collabProblemId}},
    "userEmail": "{{outsiderEmail}}"
  }
}

tests {
  test("Invite Collaborator as Owner", function () {
    expect(res.status).to.equal(200);
    expect(res.body.errors).to.be.undefined;
    const value = res.body.data.inviteCollaborator;
    expect(value.userId).to.equal(Number(bru.getVar("outsiderUserId")));
    expect(value.problemId).to.equal(Number(bru.getVar("collabProblemId")));
    expect(value.status).to.equal("Approved");
    expect(value.role).to.equal("Editor");
    expect(value.invitedById).to.equal(Number(bru.getVar("ownerUserId")));
    expect(value.invitedAt).to.be.a("string");
    expect(value.approvedAt).to.be.a("string");
  });
}
