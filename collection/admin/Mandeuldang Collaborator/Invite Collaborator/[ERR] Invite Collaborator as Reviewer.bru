meta {
  name: [ERR] Invite Collaborator as Reviewer
  type: graphql
  seq: 10
}

post {
  url: {{gqlUrl}}
  body: graphql
  auth: bearer
}

headers {
  X-Collaborator-Test: true
  X-Collaborator-Actor: reviewer
}

auth:bearer {
  token: {{reviewerToken}}
}

body:graphql {
  mutation ($problemId: Int!, $userEmail: String!) {
    inviteCollaborator(
      problemId: $problemId
      input: {userEmail: $userEmail, role: Editor}
    ) {
      id
      problemId
      userId
      role
      status
      invitedById
      invitedAt
      approvedAt
      createTime
    }
  }
}

body:graphql:vars {
  {
    "problemId": {{collabProblemId}},
    "userEmail": "{{outsiderEmail}}"
  }
}

tests {
  test("Invite Collaborator as Reviewer - FORBIDDEN", function () {
    expect(res.status).to.equal(200);
    expect(res.body.errors).to.be.an("array").that.is.not.empty;
    const error = res.body.errors.find(e => e.path && e.path[0] === "inviteCollaborator");
    expect(error).to.not.equal(undefined);
    expect(error.extensions.code).to.equal("FORBIDDEN");
    expect(error.message).to.equal("No permission to invite collaborator");
    expect(res.body.data == null || res.body.data.inviteCollaborator == null).to.equal(true);
  });
}
