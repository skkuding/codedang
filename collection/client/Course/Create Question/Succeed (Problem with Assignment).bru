meta {
  name: Succeed (Problem with Assignment)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/course/1/qna?problemId=2&assignmentId=1
  body: json
  auth: none
}

body:json {
  {
    "title": "2번 문제에 대한 과제 질문입니다",
    "content": "2번 문제의 입력 조건을 확인하고 싶습니다.",
    "isPrivate": false
  }
}

script:pre-request {
  const login = require('./login');
  await login.loginUser(req);
}

tests {
  test("should return 201 Created with assignment mapping", function() {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(data.category).to.equal("Problem");
    expect(data.problemId).to.equal(2);
    expect(data.assignmentId).to.equal(1);
    expect(data.assignmentTitle).to.equal("SKKU Coding Platform 모의과제");
    expect(data.isExercise).to.equal(false);
  });
}

docs {
  # 📘 Create Course Question - Problem with Assignment

  **POST** `/course/1/qna?problemId=2&assignmentId=1`

  `problemId`와 `assignmentId`를 함께 전달하여 문제 질문을 생성합니다.
  `isExercise`는 요청하지 않으며, 과제 정보에서 조회되어 응답에 포함됩니다.

  ---

  ### 📥 Request Parameters

  #### Path Parameters

  | Name | Type | Required | Description |
  |------|------|----------|-------------|
  | `id` | number | ✅ | Course ID |

  #### Query Parameters

  | Name | Type | Required | Description |
  |------|------|----------|-------------|
  | `problemId` | number | ✅ | Problem ID |
  | `assignmentId` | number | ✅ | Assignment ID |

  ---

  ### 📤 Response

  **Content-Type:** **application/json**

```json
  {
    "id": 1,
    "order": 1,
    "title": "질문 제목",
    "content": "질문 내용",
    "isPrivate": false,
    "isResolved": false,
    "category": "Problem",
    "problemId": 2,
    "createTime": "2026-08-13T13:11:47.296Z",
    "readBy": [7],
    "createdBy": {
      "username": "user01"
    },
    "assignmentId": 1,
    "assignmentTitle": "SKKU Coding Platform 모의과제",
    "isExercise": false
  }
```
}
