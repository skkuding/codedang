meta {
  name: Succeed (General)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/course/2/qna
  body: json
  auth: none
}

body:json {
  {
    "title": "강의 전반에 대한 질문입니다",
    "content": "이번 주차 과제 제출 기한이 언제인가요?",
    "isPrivate": false
  }
}

script:pre-request {
  const login = require('./login');
  await login.loginUser(req);
}

tests {
  test("should return 201 Created", function() {
    const data = res.getBody();
    expect(res.getStatus()).to.equal(201);
    expect(data).to.have.property('id');
    expect(data).to.have.property('order');
    expect(data.title).to.equal("강의 전반에 대한 질문입니다");
    expect(data.content).to.equal("이번 주차 과제 제출 기한이 언제인가요?");
    expect(data.isPrivate).to.equal(false);
    expect(data.category).to.equal("General");
    expect(data.problemId).to.equal(null);
    expect(data.assignmentId).to.equal(null);
    expect(data.assignmentTitle).to.equal(null);
    expect(data.isExercise).to.equal(null);
  });
}

docs {
  # 📘 Create Course Question - General

  **POST** `/course/:id/qna`

  `problemId`와 `assignmentId`를 모두 생략하면 일반 질문을 생성합니다.

  ### 📥 Parameters

  | Name | Type | Required | Description |
  |---|---|---|---|
  | `id` | number | ✅ | Course ID |

  ### 📤 Response

```json
  {
    "id": 1,
    "order": 1,
    "title": "질문 제목",
    "content": "질문 내용",
    "isPrivate": false,
    "isResolved": false,
    "category": "General",
    "problemId": null,
    "createTime": "2026-08-13T13:10:40.642Z",
    "readBy": [7],
    "createdBy": {
      "username": "user01"
    },
    "assignmentId": null,
    "assignmentTitle": null,
    "isExercise": null
  }
```
}
