meta {
  name: [403] Cannot Comment on Others Private
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/course/1/qna/2/comment
  body: json
  auth: none
}

body:json {
  {
    "content": "Forbidden comment on private question"
  }
}

script:pre-request {
  const login = require('./login');
  await login.loginUser3rd(req);  // user03: 강의 멤버이지만 작성자(user02)도 리더도 아님
}

settings {
  encodeUrl: true
}

tests {
  test("should return 403 Forbidden", function() {
    expect(res.getStatus()).to.equal(403);
  });
}

docs {
  # 📘 Create Comment - Cannot Comment on Private Question

  다른 학생의 비밀글에 댓글을 작성하려고 하면 403 Forbidden 에러가 발생합니다.

  비밀글 댓글 작성 권한:
  - 질문 작성자 본인
  - 교수/조교

  강의 1의 2번 질문은 user02가 작성한 비밀글이므로, 같은 강의의 다른 학생인 user03으로 요청합니다.
}
