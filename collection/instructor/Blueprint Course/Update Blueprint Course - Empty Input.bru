meta {
  name: Update Blueprint Course - Empty Input
  type: graphql
  seq: 9
}

post {
  url: {{gqlUrl}}
  body: graphql
  auth: none
}

body:graphql {
  mutation {
    updateBlueprintCourse(blueprintCourseId: 1, input: {}) { id }
  }
}

tests {
  test("Rejects an input without fields", function () {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.errors).to.be.an("array").that.is.not.empty;
    expect(body.errors[0].extensions.code).to.equal("BAD_REQUEST");
    expect(body.data).to.equal(null);
  });
}
