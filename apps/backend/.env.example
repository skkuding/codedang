# NOTE: Some values are loaded by direnv from the root `.envrc` file.

### Database ###
DATABASE_URL="postgresql://postgres:1234@127.0.0.1:5433/skkuding?schema=public"
TEST_DATABASE_URL="postgresql://postgres:1234@127.0.0.1:5434/skkuding?schema=public"

### Redis ###
REDIS_HOST="127.0.0.1"
REDIS_PORT="6380"
REDIS_PASSWORD="skku1234"

### MinIO ###
# To reuse AWS SDK, we use the AWS environment variables for MinIO credentials.
AWS_ACCESS_KEY_ID="skku"
AWS_SECRET_ACCESS_KEY="skku1234"

### OpenTelemetry ###
# 로컬 관측성 스택(docker compose --profile observability up)의 collector 주소.
# 미설정 시 코드 기본값이 localhost:4317이라 그대로 동작한다.
OTEL_EXPORTER_OTLP_ENDPOINT_URL="localhost:4317"

# NOTE: 계측을 끄는 DISABLE_INSTRUMENTATION은 이 파일에 적어도 동작하지 않는다.
# main.ts가 NestFactory보다 먼저 Instrumentation.start()를 호출하는데,
# 그 시점에는 ConfigModule이 .env를 아직 읽지 않았기 때문이다.
# 끄려면 셸 환경변수로 준다: DISABLE_INSTRUMENTATION=true pnpm start client

### RabbitMQ judge routing ###
# TEST_KEY and REJUDGE_KEY are intentionally unset by default. They fall back
# to JUDGE_SUBMISSION_ROUTING_KEY, preserving the former single judge request
# queue behavior until the split queue topology and workers are provisioned.
SUBMISSION_KEY="judge.submission"
# TEST_KEY="judge.test"
# REJUDGE_KEY="judge.rejudge"
# Legacy fallback used by deployments that have not configured the keys above.
JUDGE_SUBMISSION_ROUTING_KEY="judge.submission"

################################################################################
# NOTE: The following variables are sensitive.
# Please copy the values from Notion 'Secrets' page, or fill in your own values.
################################################################################

### JWT Auth ###
JWT_SECRET=""

### Nodemailer ###
NODEMAILER_HOST=""
NODEMAILER_USER=""
NODEMAILER_PASS=""
NODEMAILER_FROM=""

### OAuth ###
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
KAKAO_CLIENT_ID=""
KAKAO_CLIENT_SECRET=""
KAKAO_ADMIN_KEY=""
KAKAO_CALLBACK_URL=""
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
