{
  "extends": "@istanbuljs/nyc-config-typescript",
  "all": true,
  "check-coverage": false,
  "include": [
    "{apps,libs}/**/*.{service,resolver}.ts",
    "libs/prisma/src/script-client.ts",
    "libs/prisma/src/prisma-pool.ts"
  ],
  "exclude": [
    "**/*.spec.ts"
  ],
  "reporter": [
    "lcov",
    "text"
  ]
}
